# Copy file ini ke .env untuk development lokal
# cp .env.example .env
#
# JANGAN commit file .env ke git!

# -------------------------------------------------------
# Remote server config (server_remote.py)
# -------------------------------------------------------

# API keys untuk akses remote MCP — pisah dengan koma
# Generate key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=key1_disini,key2_disini

# Max request per menit per API key (default: 20)
RATE_LIMIT_PER_MIN=20

# Port (Railway set ini otomatis, tidak perlu diubah)
# PORT=8000

# -------------------------------------------------------
# Data source config (opsional)
# -------------------------------------------------------

# Exchange default untuk crypto (bybit/okx/kucoin/gateio)
# CRYPTO_EXCHANGE=bybit

# -------------------------------------------------------
# Automation / execution bot (run_bot.py) — EKSEKUSI ORDER SUNGGUHAN
# -------------------------------------------------------
# JANGAN set TRADING_MODE=live sampai kamu sudah tes lama di dry_run.

# Exchange default: Indodax (berlisensi Bappebti, tidak geo-block IP Indonesia —
# beda dari Binance/Bybit yang terbukti blokir IP Indonesia). Indodax TIDAK punya
# testnet, jadi EXCHANGE_TESTNET harus tetap false untuk exchange ini.
EXECUTION_EXCHANGE=indodax

# API key exchange (kosongkan untuk coba dry_run tanpa akun sama sekali)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# true = pakai testnet/sandbox exchange (uang virtual) — HANYA untuk exchange yang
# support sandbox di ccxt (misal Bybit). Indodax tidak punya testnet: kalau
# EXECUTION_EXCHANGE=indodax, ini WAJIB false, bot akan menolak start kalau true.
EXCHANGE_TESTNET=false

# "dry_run" (default, tidak pernah kirim order sungguhan) atau "live"
TRADING_MODE=dry_run

# Watchlist simbol crypto, pisah koma, format ccxt "BASE/QUOTE".
# Indodax quote utamanya IDR. Cek pasangan yang beneran ada di akun kamu dengan:
# python -c "import ccxt; print(sorted(ccxt.indodax().load_markets().keys()))"
WATCHLIST=BTC/IDR,ETH/IDR

# Timeframe candle untuk sinyal & interval polling (detik)
EXECUTION_TIMEFRAME=1h
POLL_INTERVAL_SECONDS=300

# Minimum confluence score (0-8) sebelum sinyal dieksekusi
MIN_CONFLUENCE_SCORE=6

# --- Risk limits (hard stop, bukan saran) ---
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=25
MAX_OPEN_POSITIONS=3
RISK_PER_TRADE_PCT=1.0
ATR_STOP_MULTIPLIER=1.5
ATR_TARGET_MULTIPLIER=2.5

# Balance simulasi dipakai dry_run TANPA API key
DRY_RUN_BALANCE_USD=1000

# Kill switch: bot langsung berhenti buka posisi baru kalau file ini ada.
# touch KILL_SWITCH  ->  bot berhenti entry baru pada putaran berikutnya.
KILL_SWITCH_PATH=KILL_SWITCH

# -------------------------------------------------------
# Signal source: "rules" (default, deterministik) atau "llm" (Qwen baca indikator + berita)
# -------------------------------------------------------
# PENTING: apapun SIGNAL_SOURCE-nya, risk limit di atas (MAX_POSITION_USD,
# MAX_DAILY_LOSS_USD, dll) TETAP berlaku dan tidak bisa di-override oleh LLM.
# LLM cuma boleh memilih arah (beli/exit/diam), bukan ukuran posisi.
SIGNAL_SOURCE=rules

# API key OpenRouter (openrouter.ai) — wajib diisi kalau SIGNAL_SOURCE=llm
OPENROUTER_API_KEY=

# ID model di OpenRouter — CEK DULU ke openrouter.ai/models sebelum live,
# ID model suka berubah penamaannya.
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Timeout panggilan LLM (detik) — kalau timeout/gagal, fallback otomatis ke NONE (tidak ada aksi)
LLM_TIMEOUT_SECONDS=20

# Berapa banyak & seberapa baru headline berita yang diambil sebagai konteks LLM
NEWS_MAX_HEADLINES=8
NEWS_LOOKBACK_HOURS=24
